{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mulazim",
  "version": "0.5.0",
  "identifier": "com.mulazim.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mulazim",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.github.com https://github.com https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "zimkk",
    "homepage": "https://github.com/zimkk/mulazim",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Personal project & task command center",
    "longDescription": "A personal, cloud-first desktop tracker for freelance clients, projects and tasks. Keeps every active piece of work visible so nothing gets neglected.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English",
          "German",
          "French",
          "Spanish",
          "Italian",
          "Portuguese",
          "Dutch",
          "Japanese",
          "Korean",
          "SimpChinese",
          "TradChinese",
          "Turkish",
          "Arabic"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "Mulazim",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "cd138d1e-5912-5325-b968-8410095615bc",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "copyright": "© 2026 zimkk. MIT licensed."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zimkk/mulazim/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QTY1QTY5MzE5RTEwMjkKUldRcEVKNHhhVnFtbU9WWS9MaTJ6eXJoNGJHUWV4K0JRa2gySU43b3R0UENtNU9sWTdtek9jSGYK"
    }
  }
}
